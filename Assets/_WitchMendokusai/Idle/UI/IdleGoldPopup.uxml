<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="BattleScreen.uss" />
    <ui:VisualElement name="popup" class="idle-modal-shade idle-gold-popup idle-hidden">
        <ui:VisualElement class="idle-box idle-gold-panel idle-dialog">
            <ui:VisualElement class="idle-gold-icon" />
            <ui:Label text="골드" class="idle-cap" />
            <ui:Label name="gold-amount" class="idle-gold-amount" />
            <ui:Label name="gold-income" class="idle-gold-income" />
            <ui:Button name="gold-close" text="닫기" class="idle-gold-close" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
