.traversal-hud {
    position: absolute;
    left: 16px;
    top: 100px;
    width: 600px;
    max-width: 80%;
    padding: 12px;
    background-color: rgba(15, 24, 34, 0.92);
    color: rgb(242, 248, 249);
    font-size: 15px;
    border-radius: 6px;
}
.traversal-hud Label { white-space: normal; }
.traversal-buttons { flex-direction: row; margin-top: 8px; }
.traversal-buttons Button { min-width: 150px; margin-right: 8px; }
