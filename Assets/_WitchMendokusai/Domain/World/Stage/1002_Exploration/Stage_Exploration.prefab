  - {fileID: 7049922847180033857}
  checkpointPlatforms:
  - {fileID: 6286430652023324222}
  - {fileID: 8018412753060155595}
  - {fileID: 5292559864351594448}
  - {fileID: 2044195162871467087}
  - {fileID: 199840110765272563}
  - {fileID: 5938885912250895235}
  - {fileID: 2056946536277176859}
  hudStyle: {fileID: 7433441132597879392, guid: cd8503e8d960cc34aab35c6c2f35e0cb, type: 3}
  fallLimit: -6
  checkpointRadius: 2
  isolationHeight: 100
  courseName: "\uAE08\uBE5B \uAE30\uB465 \uD0D0\uD5D8"
  routeInstructions:
  - "\uBCBD\uAE38\uC744 \uC9C0\uB098 \uCCAD\uB85D \uD45C\uC2DD\uAE4C\uC9C0 \uC804\uC9C4. \uC624\uB978\uCABD\uC73C\uB85C \uAEBE\uC774\uB294 \uAE34 \uD1B5\uB85C \uCC3E\uAE30."
  - "\uB3D9\uCABD \uAE34 \uD1B5\uB85C \uB05D\uAE4C\uC9C0 \uC774\uB3D9. \uAE30\uB465 \uC606\uC5D0\uC11C \uB9C8\uC6B0\uC2A4\uB85C \uC2DC\uC57C \uC870\uC808."
  - "\uC67C\uCABD\uC73C\uB85C \uB3CC\uC544 \uBD81\uCABD \uD1B5\uB85C \uB05D\uAE4C\uC9C0. \uAE08\uBE5B \uAE30\uB465\uC774 \uCD5C\uC885 \uBAA9\uD45C."
  - "\uB2E4\uC2DC \uC67C\uCABD, \uC11C\uCABD \uD1B5\uB85C \uB05D\uC758 \uCCAD\uB85D \uC808\uBCBD \uCC3E\uAE30."
  - "\uC624\uB978\uCABD \uCCAD\uB85D \uC808\uBCBD\uC73C\uB85C \uC774\uB3D9. \uBCBD\uC744 \uD5A5\uD574 \uC804\uC9C4\uD558\uBA74 \uB4F1\uBC18, \uAF2D\uB300\uAE30\uAE4C\uC9C0 \uBC00\uAE30."
  - "\uBC1C\uD310 \uBC16\uC73C\uB85C \uAC78\uC740 \uB4A4 Space \uD55C \uBC88\uC73C\uB85C \uD65C\uACF5. \uAC74\uB108\uD3B8 \uC12C\uC5D0 \uCC29\uC9C0 \uD6C4 \uAE08\uBE5B \uAE30\uB465\uAE4C\uC9C0."
  - "\uBAA9\uD45C \uB3C4\uCC29. Tab\uC73C\uB85C \uCEE4\uC11C\uB97C \uD480\uACE0 \uC774\uC804 Stage\uB85C \uADC0\uD658. \uC774\uB3D9\uACFC \uC2DC\uC810 \uC124\uC815 \uC790\uB3D9 \uBCF5\uC6D0."
  cameraDriver: {fileID: 6537906853344248943}
